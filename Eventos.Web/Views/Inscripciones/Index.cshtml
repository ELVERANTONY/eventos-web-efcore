@model IEnumerable<Eventos.Web.Models.Inscripcion>

@{
    ViewData["Title"] = "Gestión de Inscripciones";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-ticket-perforated me-2"></i>Historial de Inscripciones</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i>Nueva Inscripción
    </a>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Evento</th>
                <th>Asistente</th>
                <th>Fecha de Inscripción</th>
                <th class="text-center">Estado</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="6" class="text-center py-4 text-muted">
                        No hay inscripciones registradas en el sistema.
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td>#@item.Id</td>
                    <td>
                        <div class="fw-bold">@(item.Evento?.Titulo ?? "Evento no disponible")</div>
                        <small class="text-muted">
                            <i class="bi bi-calendar me-1"></i>@(item.Evento != null ? item.Evento.Fecha.ToString("dd/MM/yyyy HH:mm") : "-")
                            | <span class="badge bg-light text-dark border">@(item.Evento?.Modalidad ?? "-")</span>
                        </small>
                    </td>
                    <td>
                        <div class="fw-bold">@(item.Asistente?.Nombres ?? "Asistente no disponible")</div>
                        <small class="text-muted">
                            DNI: @(item.Asistente?.Dni ?? "-") | @(item.Asistente?.Correo ?? "-")
                        </small>
                    </td>
                    <td>@item.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-center">
                        @if (item.Estado == "Confirmada")
                        {
                            <span class="badge bg-success">Confirmada</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Cancelada</span>
                        }
                    </td>
                    <td class="text-center">
                        @if (item.Estado == "Confirmada")
                        {
                            <form asp-action="Cancelar" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('¿Seguro que deseas cancelar esta inscripción?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Cancelar Inscripción">
                                    <i class="bi bi-x-circle me-1"></i>Cancelar
                                </button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted small">Sin acciones</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
