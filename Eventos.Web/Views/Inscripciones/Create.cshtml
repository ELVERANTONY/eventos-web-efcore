@model Eventos.Web.Models.Inscripcion

@{
    ViewData["Title"] = "Nueva Inscripción";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-modern">
            <div class="card-modern-header d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-ticket-perforated text-success me-2"></i>Registrar Nueva Inscripción
                    </h5>
                    <small class="text-muted">Asocia un asistente a un evento disponible</small>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2"></div>

                    <div class="mb-3">
                        <label asp-for="EventoId" class="form-label">Evento Activo</label>
                        <select asp-for="EventoId" asp-items="ViewBag.EventoId" class="form-select">
                            <option value="">-- Seleccionar Evento --</option>
                        </select>
                        <span asp-validation-for="EventoId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="AsistenteId" class="form-label">Asistente Activo</label>
                        <select asp-for="AsistenteId" asp-items="ViewBag.AsistenteId" class="form-select">
                            <option value="">-- Seleccionar Asistente --</option>
                        </select>
                        <span asp-validation-for="AsistenteId" class="text-danger small"></span>
                    </div>

                    <div class="alert alert-light border d-flex align-items-center gap-2 mb-4 text-muted small">
                        <i class="bi bi-info-circle-fill text-primary fs-5"></i>
                        <div>
                            La inscripción se creará en estado <strong>Confirmada</strong> y se reservará automáticamente una vacante en el aforo del evento.
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 px-3">Cancelar</a>
                        <button type="submit" class="btn btn-primary-modern px-4">
                            <i class="bi bi-check-lg me-1"></i>Confirmar Inscripción
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
