@model Eventos.Web.Models.Asistente

@{
    ViewData["Title"] = "Registrar Asistente";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-person-plus me-2"></i>Registrar Nuevo Asistente</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nombres" class="form-label fw-bold">Nombres Completos</label>
                        <input asp-for="Nombres" class="form-control" placeholder="Ej. Juan Pérez Ramos" />
                        <span asp-validation-for="Nombres" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Dni" class="form-label fw-bold">DNI (8 dígitos)</label>
                            <input asp-for="Dni" class="form-control" maxlength="8" placeholder="Ej. 12345678" />
                            <span asp-validation-for="Dni" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label fw-bold">Teléfono (Opcional, máx. 9)</label>
                            <input asp-for="Telefono" class="form-control" maxlength="9" placeholder="Ej. 987654321" />
                            <span asp-validation-for="Telefono" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Correo" class="form-label fw-bold">Correo Electrónico</label>
                        <input asp-for="Correo" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                        <span asp-validation-for="Correo" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Regresar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Guardar Asistente
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
