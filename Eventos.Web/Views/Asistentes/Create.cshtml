@model Eventos.Web.Models.Asistente

@{
    ViewData["Title"] = "Registrar Asistente";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card card-modern">
            <div class="card-modern-header d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-person-plus text-primary me-2"></i>Registrar Nuevo Asistente
                    </h5>
                    <small class="text-muted">Ingresa los datos personales del participante</small>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Nombres" class="form-label">Nombres Completos</label>
                        <input asp-for="Nombres" class="form-control" placeholder="Ej. Juan Carlos Pérez Romero" />
                        <span asp-validation-for="Nombres" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Dni" class="form-label">DNI (8 dígitos)</label>
                            <input asp-for="Dni" class="form-control" maxlength="8" placeholder="Ej. 74125896" />
                            <span asp-validation-for="Dni" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Telefono" class="form-label">Teléfono (Opcional, máx. 9)</label>
                            <input asp-for="Telefono" class="form-control" maxlength="9" placeholder="Ej. 987654321" />
                            <span asp-validation-for="Telefono" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Correo" class="form-label">Correo Electrónico</label>
                        <input asp-for="Correo" type="email" class="form-control" placeholder="nombre@correo.com" />
                        <span asp-validation-for="Correo" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 px-3">Cancelar</a>
                        <button type="submit" class="btn btn-primary-modern px-4">
                            <i class="bi bi-check-lg me-1"></i>Guardar Asistente
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
