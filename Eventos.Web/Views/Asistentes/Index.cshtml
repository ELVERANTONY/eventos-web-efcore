@model IEnumerable<Eventos.Web.Models.Asistente>

@{
    ViewData["Title"] = "Gestión de Asistentes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-people me-2"></i>Directorio de Asistentes</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus me-1"></i>Nuevo Asistente
    </a>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-striped table-hover align-middle mb-0">
        <thead class="table-dark">
            <tr>
                <th>Nombres y Apellidos</th>
                <th>DNI</th>
                <th>Correo Electrónico</th>
                <th>Teléfono</th>
                <th>Estado</th>
            </tr>
        </thead>
        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="5" class="text-center py-4 text-muted">
                        No hay asistentes registrados actualmente.
                    </td>
                </tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.Nombres</td>
                    <td><code>@item.Dni</code></td>
                    <td><a href="mailto:@item.Correo" class="text-decoration-none">@item.Correo</a></td>
                    <td>@(string.IsNullOrWhiteSpace(item.Telefono) ? "-" : item.Telefono)</td>
                    <td>
                        <span class="badge bg-success">Activo</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
