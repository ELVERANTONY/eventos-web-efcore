@model IEnumerable<Eventos.Web.Models.Asistente>

@{
    ViewData["Title"] = "Gestión de Asistentes";
}

<!-- Cabecera de Página -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-people text-primary"></i> Directorio de Asistentes
        </h2>
        <p class="text-muted mb-0">Listado de asistentes registrados ordenados alfabéticamente.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-modern">
        <i class="bi bi-person-plus me-1"></i> Nuevo Asistente
    </a>
</div>

<!-- Tabla de Asistentes -->
<div class="table-card">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>Nombres y Apellidos</th>
                    <th>DNI</th>
                    <th>Correo Electrónico</th>
                    <th>Teléfono</th>
                    <th class="text-center">Estado</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-person-x fs-1 d-block mb-2 text-secondary"></i>
                            No hay asistentes registrados en el sistema.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <div class="bg-primary-subtle text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                     style="width: 36px; height: 36px; font-size: 0.85rem;">
                                    @(item.Nombres.FirstOrDefault())
                                </div>
                                <span class="fw-bold text-dark">@item.Nombres</span>
                            </div>
                        </td>
                        <td><code class="fw-semibold">@item.Dni</code></td>
                        <td>
                            <a href="mailto:@item.Correo" class="text-decoration-none text-primary">
                                <i class="bi bi-envelope me-1"></i>@item.Correo
                            </a>
                        </td>
                        <td>
                            <span class="text-muted">
                                <i class="bi bi-telephone me-1"></i>@(string.IsNullOrWhiteSpace(item.Telefono) ? "-" : item.Telefono)
                            </span>
                        </td>
                        <td class="text-center">
                            <span class="badge-soft badge-soft-success">
                                <i class="bi bi-check-circle-fill"></i> Activo
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
