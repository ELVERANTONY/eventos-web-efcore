@model IEnumerable<Eventos.Web.Models.Evento>

@{
    ViewData["Title"] = "Gestión de Eventos";
}

<!-- Cabecera de Página -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1 d-flex align-items-center gap-2">
            <i class="bi bi-calendar-event text-primary"></i> Eventos Disponibles
        </h2>
        <p class="text-muted mb-0">Catálogo de eventos activos, aforos e inscripciones en tiempo real.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary-modern">
        <i class="bi bi-plus-lg me-1"></i> Nuevo Evento
    </a>
</div>

<!-- Filtro por Categoría -->
<div class="card card-modern mb-4">
    <div class="card-body p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label">
                    <i class="bi bi-funnel text-primary me-1"></i>Filtrar por Categoría:
                </label>
                <select name="categoriaId" asp-items="ViewBag.Categorias" class="form-select">
                    <option value="">-- Todas las Categorías --</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary-modern">
                    <i class="bi bi-search me-1"></i>Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Eventos -->
<div class="table-card">
    <div class="table-responsive">
        <table class="table table-modern">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Categoría</th>
                    <th>Fecha &amp; Hora</th>
                    <th>Lugar</th>
                    <th>Modalidad</th>
                    <th>Aforo</th>
                    <th>Precio</th>
                    <th class="text-center">Inscritos</th>
                    <th class="text-center">Cupos Disp.</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                            No se encontraron eventos activos para el filtro seleccionado.
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    var inscritosConfirmados = item.Inscripciones.Count(i => i.Estado == "Confirmada");
                    var cuposDisponibles = item.Aforo - inscritosConfirmados;
                    <tr>
                        <td>
                            <span class="fw-bold text-dark">@item.Titulo</span>
                        </td>
                        <td>
                            <span class="badge-soft badge-soft-primary">
                                <i class="bi bi-tag-fill me-1"></i>@(item.Categoria?.Nombre ?? "Sin categoría")
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1 text-muted">
                                <i class="bi bi-clock"></i>
                                <span>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-1 text-muted">
                                <i class="bi bi-geo-alt"></i>
                                <span>@item.Lugar</span>
                            </div>
                        </td>
                        <td>
                            @if (item.Modalidad == "Presencial")
                            {
                                <span class="badge-soft badge-soft-info">
                                    <i class="bi bi-person-workspace"></i> Presencial
                                </span>
                            }
                            else
                            {
                                <span class="badge-soft badge-soft-success">
                                    <i class="bi bi-camera-video"></i> Virtual
                                </span>
                            }
                        </td>
                        <td class="fw-semibold">@item.Aforo</td>
                        <td class="fw-bold text-dark">
                            @(item.Precio == 0 ? "Gratis" : item.Precio.ToString("C2"))
                        </td>
                        <td class="text-center">
                            <span class="badge-soft badge-soft-secondary">
                                @inscritosConfirmados
                            </span>
                        </td>
                        <td class="text-center">
                            @if (cuposDisponibles <= 0)
                            {
                                <span class="badge-soft badge-soft-danger">
                                    <i class="bi bi-x-circle-fill"></i> Agotado
                                </span>
                            }
                            else
                            {
                                <span class="badge-soft badge-soft-success">
                                    <i class="bi bi-check-circle-fill"></i> @cuposDisponibles
                                </span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-inline-flex gap-1">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-action btn-action-view" title="Ver Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action btn-action-edit" title="Editar Evento">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action btn-action-delete" title="Eliminar Lógicamente">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
