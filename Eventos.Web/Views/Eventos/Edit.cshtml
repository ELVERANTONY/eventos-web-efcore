@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Editar Evento";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-modern">
            <div class="card-modern-header d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-pencil-square text-warning me-2"></i>Editar Evento
                    </h5>
                    <small class="text-muted">Modifica los detalles del evento seleccionado</small>
                </div>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3">
                    <i class="bi bi-arrow-left me-1"></i>Volver
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Activo" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3 py-2"></div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label">Título del Evento</label>
                        <input asp-for="Titulo" class="form-control" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label">Categoría</label>
                            <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-select"></select>
                            <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Modalidad" class="form-label">Modalidad</label>
                            <select asp-for="Modalidad" asp-items="ViewBag.Modalidades" class="form-select"></select>
                            <span asp-validation-for="Modalidad" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Fecha" class="form-label">Fecha y Hora</label>
                            <input asp-for="Fecha" type="datetime-local" class="form-control" />
                            <span asp-validation-for="Fecha" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Lugar" class="form-label">Lugar / Plataforma</label>
                            <input asp-for="Lugar" class="form-control" />
                            <span asp-validation-for="Lugar" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Aforo" class="form-label">Aforo Máximo</label>
                            <input asp-for="Aforo" class="form-control" type="number" min="1" max="5000" />
                            <span asp-validation-for="Aforo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Precio" class="form-label">Precio de Entrada (S/)</label>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="Precio" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                        <a asp-action="Index" class="btn btn-light rounded-3 px-3">Cancelar</a>
                        <button type="submit" class="btn btn-primary-modern px-4">
                            <i class="bi bi-save me-1"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
