@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Crear Evento";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0"><i class="bi bi-calendar-plus me-2"></i>Registrar Nuevo Evento</h4>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label fw-bold">Título del Evento</label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ej. Congreso de Inteligencia Artificial" />
                        <span asp-validation-for="Titulo" class="text-danger"></span>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="CategoriaId" class="form-label fw-bold">Categoría</label>
                            <select asp-for="CategoriaId" asp-items="ViewBag.CategoriaId" class="form-select">
                                <option value="">-- Seleccione Categoría --</option>
                            </select>
                            <span asp-validation-for="CategoriaId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Modalidad" class="form-label fw-bold">Modalidad</label>
                            <select asp-for="Modalidad" asp-items="ViewBag.Modalidades" class="form-select"></select>
                            <span asp-validation-for="Modalidad" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Fecha" class="form-label fw-bold">Fecha y Hora</label>
                            <input asp-for="Fecha" type="datetime-local" class="form-control" />
                            <span asp-validation-for="Fecha" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Lugar" class="form-label fw-bold">Lugar / Plataforma</label>
                            <input asp-for="Lugar" class="form-control" placeholder="Ej. Auditorio o enlace Teams" />
                            <span asp-validation-for="Lugar" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label asp-for="Aforo" class="form-label fw-bold">Aforo Máximo (1 a 5000)</label>
                            <input asp-for="Aforo" class="form-control" type="number" min="1" max="5000" />
                            <span asp-validation-for="Aforo" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Precio" class="form-label fw-bold">Precio (S/)</label>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" min="0" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Regresar
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Guardar Evento
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
