@model Eventos.Web.Models.Evento

@{
    ViewData["Title"] = "Detalles del Evento";
    var inscripcionesConfirmadas = Model.Inscripciones.Where(i => i.Estado == "Confirmada").ToList();
    var cuposDisponibles = Model.Aforo - inscripcionesConfirmadas.Count;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="card card-modern mb-4">
            <div class="card-modern-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge-soft @(Model.Modalidad == "Presencial" ? "badge-soft-info" : "badge-soft-success") fs-6">
                        <i class="bi @(Model.Modalidad == "Presencial" ? "bi-person-workspace" : "bi-camera-video") me-1"></i>@Model.Modalidad
                    </span>
                    <span class="badge-soft badge-soft-primary fs-6">
                        @(Model.Categoria?.Nombre ?? "Sin categoría")
                    </span>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm rounded-3">
                        <i class="bi bi-pencil me-1"></i>Editar
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-3">
                        <i class="bi bi-arrow-left me-1"></i>Volver
                    </a>
                </div>
            </div>
            <div class="card-body p-4">
                <h3 class="fw-bold text-dark mb-4">@Model.Titulo</h3>

                <!-- Tarjetas de Métricas Rápidas -->
                <div class="row g-3 mb-4">
                    <div class="col-sm-6 col-md-3">
                        <div class="p-3 bg-light rounded-4 border">
                            <small class="text-muted d-block mb-1"><i class="bi bi-clock me-1"></i>Fecha y Hora</small>
                            <span class="fw-bold text-dark">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="p-3 bg-light rounded-4 border">
                            <small class="text-muted d-block mb-1"><i class="bi bi-geo-alt me-1"></i>Ubicación</small>
                            <span class="fw-bold text-dark">@Model.Lugar</span>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="p-3 bg-light rounded-4 border">
                            <small class="text-muted d-block mb-1"><i class="bi bi-currency-dollar me-1"></i>Precio</small>
                            <span class="fw-bold text-dark">@(Model.Precio == 0 ? "Gratuito" : Model.Precio.ToString("C2"))</span>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <div class="p-3 bg-light rounded-4 border">
                            <small class="text-muted d-block mb-1"><i class="bi bi-people me-1"></i>Cupos Restantes</small>
                            @if (cuposDisponibles <= 0)
                            {
                                <span class="badge-soft badge-soft-danger">Agotado</span>
                            }
                            else
                            {
                                <span class="badge-soft badge-soft-success">@cuposDisponibles disp. / @Model.Aforo</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3 mt-4">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-person-check text-primary me-2"></i>Asistentes Confirmados (@inscripcionesConfirmadas.Count)
                    </h5>
                    <a asp-controller="Inscripciones" asp-action="Create" class="btn btn-primary-modern btn-sm">
                        <i class="bi bi-plus-circle me-1"></i>Nueva Inscripción
                    </a>
                </div>

                @if (!inscripcionesConfirmadas.Any())
                {
                    <div class="text-center py-4 text-muted bg-light rounded-3 border">
                        <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                        Aún no se registran asistentes para este evento.
                    </div>
                }
                else
                {
                    <div class="table-card">
                        <div class="table-responsive">
                            <table class="table table-modern">
                                <thead>
                                    <tr>
                                        <th>Asistente</th>
                                        <th>DNI</th>
                                        <th>Correo Electrónico</th>
                                        <th>Teléfono</th>
                                        <th>Fecha Inscripción</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ins in inscripcionesConfirmadas)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark">@(ins.Asistente?.Nombres ?? "N/A")</td>
                                            <td><code>@(ins.Asistente?.Dni ?? "N/A")</code></td>
                                            <td><a href="mailto:@ins.Asistente?.Correo" class="text-decoration-none">@ins.Asistente?.Correo</a></td>
                                            <td>@(string.IsNullOrWhiteSpace(ins.Asistente?.Telefono) ? "-" : ins.Asistente.Telefono)</td>
                                            <td class="text-muted">@ins.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
